# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Future Supabase migration/direct migration connection:
DIRECT_DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Media storage — local (default), minio, or r2
# ─────────────────────────────────────────────────────────────────────────────
MEDIA_STORAGE_DRIVER=local
MEDIA_KEEP_ORIGINALS=false

# Optional MinIO development provider
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=school-media
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000/school-media

# Future Cloudflare R2 production provider
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://media.example.com

# ─────────────────────────────────────────────────────────────────────────────
# Future Supabase Auth
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
